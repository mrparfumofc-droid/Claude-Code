   },
   {
    "pt": "Chipre e Galácia",
    "c": [
     37.0,
     32.6
    ],
    "z": 6.3,
    "t": "1ª viagem (azul)",
    "d": "Com Barnabé: Chipre, Perge, Antioquia da Pisídia, Icônio, Listra e Derbe. Na volta, visitaram cada igreja e escolheram presbíteros.",
    "r": "At 14:21-23"
   },
